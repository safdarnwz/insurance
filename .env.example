# =============================================================================
# Copy karo:  cp .env.example .env     (.env git me NAHI jaata - .gitignore)
# =============================================================================

# ---- Kahan chalana hai ----
# local      -> sab kuch laptop/Docker par (Spark local + dbt DuckDB). Koi account nahi chahiye.
# databricks -> Spark Databricks Free Edition par, dbt Databricks SQL warehouse par.
PIPELINE_ENV=local

# ---- Docker / Airflow ----
# Linux par: apna user id do (`id -u`), warna data/ files ki ownership 50000 ho jaayegi.
# Windows / Mac (Docker Desktop): ise mat chhedo.
AIRFLOW_UID=50000
# Kisi bhi random string se badlo (Airflow components ke beech auth)
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
SPARK_DRIVER_MEMORY=2g

# ---- Databricks Free Edition (sirf PIPELINE_ENV=databricks) ----
# Workspace URL (browser address bar se, sirf https://<...>.cloud.databricks.com part)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# User settings -> Developer -> Access tokens -> Generate new token
# KYA NAHI KARNA: token kabhi code/git/chat me paste mat karo. Sirf yahan.
DATABRICKS_TOKEN=
# SQL Warehouses -> Serverless Starter Warehouse -> Connection details -> HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
UC_CATALOG=workspace

# ---- Kaggle (optional, --source kaggle) ----
# KAGGLE_USERNAME=
# KAGGLE_KEY=
