{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests", "-p", "no:logging"],
  "python.envFile": "${workspaceFolder}/.env",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "files.associations": { "dbt/**/*.sql": "jinja-sql" },
  "files.exclude": { "**/__pycache__": true, "**/*.egg-info": true, "**/.pytest_cache": true },
  "[python]": { "editor.defaultFormatter": "charliermarshall.ruff", "editor.formatOnSave": true }
}
