{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "KPIs",
      "queryLines": [
        "SELECT count(*) AS members, round(sum(charges),0) AS total_charges, round(avg(charges),0) AS avg_charges, ",
        "round(avg(smoker_flag)*100,1) AS smoker_pct FROM workspace.insurance_gold.fact_member_charges"
      ]
    },
    {
      "name": "quarantine",
      "displayName": "Quarantine",
      "queryLines": [
        "SELECT count(*) AS rejected_rows FROM workspace.insurance_silver.member_charges_quarantine"
      ]
    },
    {
      "name": "region_risk",
      "displayName": "Region risk",
      "queryLines": [
        "SELECT * FROM workspace.insurance_gold.agg_region_risk"
      ]
    },
    {
      "name": "smoker_loading",
      "displayName": "Smoker loading",
      "queryLines": [
        "SELECT * FROM workspace.insurance_gold.agg_smoker_loading"
      ]
    },
    {
      "name": "segment",
      "displayName": "Segments",
      "queryLines": [
        "SELECT * FROM workspace.insurance_gold.agg_charges_by_segment"
      ]
    },
    {
      "name": "risk_segment",
      "displayName": "Risk segment",
      "queryLines": [
        "SELECT p.risk_segment, count(*) AS members, round(avg(f.charges),0) AS avg_charges ",
        "FROM workspace.insurance_gold.fact_member_charges f JOIN workspace.insurance_gold.dim_member_profile p USING (profile_key) GROUP BY ALL"
      ]
    },
    {
      "name": "yearly",
      "displayName": "Yearly",
      "queryLines": [
        "SELECT cast(policy_year AS STRING) AS policy_year, count(*) AS members, round(sum(charges),0) AS total_charges ",
        "FROM workspace.insurance_gold.fact_member_charges GROUP BY ALL ORDER BY 1"
      ]
    }
  ],
